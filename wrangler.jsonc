// Cloudflare Worker + D1 설정.
//   database_id 는 `npx wrangler d1 create rowar` 로 만든 DB 의 uuid 다.
//   비밀값이 아니다 — 이것만으로는 접근할 수 없고 계정 인증이 따로 필요하다.
//   그래서 커밋한다. 다른 PC 에서 클론하면 설정을 다시 만들지 않아도 된다.
{
  "name": "rowar",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-04",

  // 게임 파일. 리포 루트를 그대로 올리면 server/schema.sql 과 내부 문서까지
  // 공개되므로, `npm run build` 로 클라이언트 파일만 dist/ 에 모아서 올린다.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /api/* 는 정적 파일보다 Worker 가 먼저 본다.
    "run_worker_first": ["/api/*"]
  },

  // 스마트 배치(2026-09-25 사용자 지시) — Worker 를 **DB 가까이**에서 돌린다.
  // 한국 접속은 무료 요금제라 LAX 로 들어오고, DB 는 APAC 에 있어 조회 한 번마다 태평양을 왕복했다
  // (조회 5번에 약 570ms · 대전 시작처럼 여러 번 읽고 쓰는 요청은 몇 초). 정적 파일은 영향 없다.
  "placement": { "mode": "smart" },

  // Worker 안에서 env.DB 로 접근한다.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rowar",
      "database_id": "d3b96715-7ed0-4385-b947-944ca82d482b"
    }
  ],

  // 순위 집계는 30분마다. 전원의 순위를 한 문장으로 다시 매기되 실제로 바뀐 행만 쓰므로
  // 조용한 시간대에는 쓰기가 0이다. (매번 전원을 쓰면 2만 명 기준 하루 96만 행이라
  // 무료 한도 10만을 넘긴다)
  //
  // 청소는 하루 한 번(UTC 04:17 = KST 13:17)만. 전투 기록 정리가 표 전체를 훑는 데다,
  // 지우는 것도 '쓴 행'으로 세기 때문에 자주 돌 이유가 없다.
  // 이 문자열은 server/worker.js 의 DAILY_CRON 과 정확히 같아야 한다.
  "triggers": { "crons": ["*/30 * * * *", "17 4 * * *"] }
}
